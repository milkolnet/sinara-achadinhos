# Ambiente de Execução
NODE_ENV=production
PORT=3000

# Banco de Dados PostgreSQL (Opcional: quando configurado, ativa persistência relacional com Prisma)
# DATABASE_URL=postgresql://usuario:senha@host:5432/sinara_achadinhos?schema=public
DATABASE_URL=

# Autenticação Administrativa (Obrigatório em produção com segredos fortes)
ADMIN_USERNAME=curadora
ADMIN_PASSWORD=
JWT_SECRET=

# Segurança e CORS (Opcional: especifique a URL da aplicação ou deixe vazio para same-origin)
CORS_ORIGIN=

# URL Pública da Aplicação
APP_URL=
